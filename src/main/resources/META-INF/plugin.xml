<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>io.snakeOrCamel</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>SnakeOrCamel</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="tesung30@naver.com" url="https://github.com/hongmoSung/snakeOrCamel">hongmo</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description>
        <![CDATA[
Convert between naming conventions, format JSON, and add file or line references to prompts in your AI agent's terminal.

<h3>Case Conversion</h3>
<ul>
    <li><b>snake_case to camelCase</b>: my_variable_name → myVariableName</li>
    <li><b>camelCase to snake_case</b>: myVariableName → my_variable_name</li>
    <li><b>kebab-case to camelCase</b>: my-variable-name → myVariableName</li>
</ul>

<h3>JSON Prettier</h3>
<ul>
    <li>Format and beautify JSON in the tool window</li>
    <li>Validate JSON syntax</li>
    <li>Copy formatted output with one click</li>
</ul>

<h3>AI Agent Terminal</h3>
<p>Run Claude Code, Codex CLI, or a custom agent in a dedicated IDE terminal tab. Insert a reference to the current file or selected lines, such as <code>@src/App.java#L12-L18</code>, into the prompt you're writing. Press Enter when you're ready to send it.</p>

<h3>Usage</h3>
<ul>
    <li><b>Case Convert</b>: Select text → Right-click "Snake or Camel" or press <code>Ctrl+Cmd+C</code> (macOS) / <code>Ctrl+Alt+C</code> (Windows/Linux)</li>
    <li><b>JSON Prettier</b>: Open from the right tool window sidebar</li>
    <li><b>Agent Terminal</b> is off by default. Enable it under <b>Settings → Tools → SnakeOrCamel → Agent Terminal</b> and choose a default profile for an installed CLI.</li>
    <li>In the editor, right-click <b>Insert File Reference into Agent Terminal</b> or press <code>Option+Cmd+K</code> (macOS) or <code>Ctrl+Alt+K</code> (Windows/Linux) if the shortcut is available. The plugin opens or reuses the default agent's tab.</li>
</ul>

<h3>Use Cases</h3>
<ul>
    <li>Convert between Java/JavaScript camelCase and Python snake_case</li>
    <li>Transform SQL column names to programming variables</li>
    <li>Format minified JSON for readability</li>
    <li>Select a method and ask your agent to explain it using its file path and line range.</li>
</ul>
        ]]>
    </description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>
    <depends optional="true" config-file="snakeorcamel-terminal.xml">org.jetbrains.plugins.terminal</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="io.snakeorcamel.agentterminal.AgentSettings"/>
        <applicationService serviceImplementation="io.snakeorcamel.agentterminal.AgentKeymap"/>
        <postStartupActivity implementation="io.snakeorcamel.agentterminal.AgentStartup"/>
        <applicationConfigurable parentId="tools" id="SnakeOrCamel" displayName="SnakeOrCamel"
                                 instance="io.snakeorcamel.agentterminal.AgentConfigurable$Parent"/>
        <applicationService serviceImplementation="io.snakeorcamel.agentterminal.AgentProfiles"/>
        <projectService serviceImplementation="io.snakeorcamel.agentterminal.LegacyAgentProfiles"/>
        <projectService serviceImplementation="io.snakeorcamel.agentterminal.AgentSessions"/>
        <notificationGroup id="SnakeOrCamel Agent Terminal" displayType="BALLOON"/>
        <projectConfigurable parentId="SnakeOrCamel" id="SnakeOrCamel.AgentTerminal" displayName="Agent Terminal"
                                 instance="io.snakeorcamel.agentterminal.AgentConfigurable"/>
        <toolWindow
            id="JSON Prettier"
            anchor="right"
            icon="/icons/jsonPrettier.svg"
            factoryClass="io.snakeorcamel.jsonprettier.JsonPrettierToolWindowFactory"
        />
    </extensions>
    <actions>
        <group id="SnakeOrCamel.AgentTerminal.Menu" text="SnakeOrCamel" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="SnakeOrCamel.AgentTerminal.Run" class="io.snakeorcamel.agentterminal.AgentRunAction"
                    text="Run Agent…" description="Run a saved agent profile in its own Terminal tab"/>
            <action id="SnakeOrCamel.AgentTerminal.InsertReference" class="io.snakeorcamel.agentterminal.AgentInsertReferenceAction"
                    text="Insert File Reference into Agent Terminal" description="Insert the editor reference without Enter">
                <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            </action>
        </group>
        <action
            id="Name.Convert"
            class="io.snakeorcamel.caseconvert.CaseConvertAction"
            text="Snake or Camel"
            description="Change to snake case or camel case"
        >
            <add-to-group group-id="CodeFormatGroup" anchor="after" relative-to-action="ReformatCode"/>
            <add-to-group group-id="EditorPopupMenu" anchor="before" relative-to-action="ReformatCode"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control meta C"/>
        </action>
    </actions>
</idea-plugin>
